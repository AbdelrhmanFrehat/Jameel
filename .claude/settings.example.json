{
  "_comment": "Generated shape of what install/install.py merges into ~/.claude/settings.json. Replace <PROJECT_ROOT> and <PYTHON> with absolute paths (the installer does this for you). Exec form (command + args) is used so the path with spaces needs no shell quoting. Timeouts exceed the bridge's own waits so Claude Code never cancels a hook that is waiting for a button press.",
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "20"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/session_start.py"], "timeout": 15 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/user_prompt_submit.py"], "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/pre_tool_use.py"], "timeout": 320 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/post_tool_use.py"], "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/post_tool_use_failure.py"], "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/permission_request.py"], "timeout": 320 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/stop.py"], "timeout": 320 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/subagent_start.py"], "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/subagent_stop.py"], "timeout": 10 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/notification.py"], "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/session_end.py"], "timeout": 10 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/stop_failure.py"], "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/pre_compact.py"], "timeout": 10 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/hooks/post_compact.py"], "timeout": 10 } ] }
    ]
  },
  "_mcp_comment": "The MCP server goes into ~/.claude.json (user scope) or .mcp.json (project scope):",
  "_mcpServers": {
    "esp32_remote": { "type": "stdio", "command": "<PYTHON>", "args": ["<PROJECT_ROOT>/mcp_server/server.py"] }
  }
}
